{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Human in the Loop",
  "colors": {
    "primary": "#2D3748",
    "light": "#ffffff",
    "dark": "#1A202C"
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://api.hitl.sh/v1",
    "auth": {
      "method": "bearer",
      "name": "Authorization"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "introduction",
              "dashboard",
              "api-keys",
              "first-loop"
            ]
          },
          {
            "group": "Integration Guides",
            "pages": [
              "guides/simple-integration",
              "guides/response-types"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/loops",
              "concepts/requests",
              "concepts/responses",
              "concepts/integrations"
            ]
          },
          {
            "group": "Mobile App",
            "pages": [
              "mobile/overview",
              "mobile/home-screen",
              "mobile/join-loop",
              "mobile/responding"
            ]
          },
          {
            "group": "Requests",
            "pages": ["requests/introduction"]
          },
          {
            "group": "Responses",
            "pages": [
              "responses/types",
              "responses/text",
              "responses/single-select",
              "responses/multi-select",
              "responses/rating",
              "responses/number"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/n8n",
              "integrations/zapier",
              "integrations/make",
              "integrations/coming-soon"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/test-api-key",
              "api-reference/errors"
            ]
          },
          {
            "group": "Loops",
            "pages": [
              "api-reference/loops/create-loop",
              "api-reference/loops/get-loops",
              "api-reference/loops/get-loop",
              "api-reference/loops/update-loop",
              "api-reference/loops/delete-loop",
              "api-reference/loops/loop-members"
            ]
          },
          {
            "group": "Requests",
            "pages": [
              "api-reference/requests/create-request",
              "api-reference/requests/get-requests",
              "api-reference/requests/get-request",
              "api-reference/requests/cancel-request",
              "api-reference/requests/add-feedback"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Install App",
          "href": "https://hitl.sh/download",
          "icon": "download"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/jYVrpmnMP9",
          "icon": "discord"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/hitl-sh",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Team",
        "href": "mailto:team@hitl.sh"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
              "href": "https://my.hitl.sh"
    }
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude", "cursor", "vscode"]
